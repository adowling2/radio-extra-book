# macOS / editor clutter
.DS_Store

# Python figure-generation caches
__pycache__/
*.pyc

# Reference materials. Default to ignoring everything here, then allow back the
# question pools and their derived markdown: NCVEC publishes the pools for free
# reproduction, and having them in the repo is what makes a pool citation
# checkable on a fresh clone. The commercial manuals and the original Word draft
# stay out. See references/README.md.
references/*
!references/README.md
!references/HamExam.org Extra Question Pool.pdf
!references/HamExam.org General Question Pool.pdf
!references/extra-pool-circuits.md
!references/general-pool-circuits.md

# LaTeX build products
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# Root-level PDFs generated by latexmk. The curated deliverables live in output/.
main.pdf
cheat_sheet.pdf

# Output PDFs and rendered visual-QA images are useful locally but heavy for git.
output/*.pdf
output/rendered/
output/final_rendered/
